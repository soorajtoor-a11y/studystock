AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=production

# ── Supabase (also read server-side for the waitlist gate) ──────────────────
# The frontend already needs these; the server reuses the same anon key to
# verify a caller's own session JWT (auth.getUser) and to insert waitlist rows.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Waitlist gate (vye-waitlist-dev-bypass-spec.md) ─────────────────────────
# WAITLIST_MODE=true puts the whole site behind a waitlist for the public;
# only sessions whose email is in DEV_ALLOWLIST can reach the app (sign in via
# the hidden /team-access route). Flip to false at launch — that single change
# restores normal public sign-up with no code edits.
WAITLIST_MODE=false
# Comma-separated dev-team emails allowed through while WAITLIST_MODE=true
# (compared lowercase). Add a dev = add their email here and redeploy.
DEV_ALLOWLIST=you@example.com,teammate@example.com
